{
  "schemaVersion": 1,
  "id": "correctness-review",
  "description": "A reviewer in a fresh context checks the result against every acceptance criterion.",
  "required": true,
  "scope": "feature",
  "timeoutMs": 900000,
  "retries": {
    "max": 0,
    "retryOn": []
  },
  "evidence": {
    "kind": "review",
    "keepOutputLines": 40,
    "artifactPaths": []
  },
  "type": "ai-review",
  "review": {
    "profileId": "reviewer",
    "dimension": "correctness",
    "blockingSeverities": [
      "critical",
      "high"
    ],
    "skepticProfileId": "skeptic",
    "appliesWhen": "always"
  }
}

{
  "name": "@baked/desktop",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "BAKED desktop app",
  "author": "Gulliby",
  "desktopName": "baked-desktop.desktop",
  "homepage": "https://github.com/Gulliby-development/baked",
  "main": "out/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "bun scripts/build.ts",
    "package": "bun scripts/package.ts",
    "smoke": "bun scripts/smoke.ts",
    "start": "electron .",
    "lint": "biome check src/ tests/ scripts/",
    "lint:fix": "biome check --write src/ tests/ scripts/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.6.0",
    "electron-builder": "26.17.0",
    "playwright-core": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.4"
  },
  "trustedDependencies": ["electron"]
}

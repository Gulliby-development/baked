{
  "name": "@baked/desktop",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "BAKED desktop app",
  "author": "Gulliby",
  "desktopName": "baked-desktop.desktop",
  "homepage": "https://github.com/Gulliby-development/baked",
  "main": "out/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "bun scripts/build.ts",
    "package": "bun scripts/package.ts",
    "smoke": "bun scripts/smoke.ts",
    "stage:voice": "bun scripts/stage-voice.ts",
    "start": "electron .",
    "lint": "biome check src/ tests/ scripts/",
    "lint:fix": "biome check --write src/ tests/ scripts/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "e2e": "vite build --config vite.config.ts && playwright test",
    "e2e:electron": "bun run build && playwright test -c playwright.electron.config.ts",
    "e2e:live": "bun run build && playwright test -c playwright.live.config.ts"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@biomejs/biome": "2.5.15",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-drag": "3.0.7",
    "@types/d3-ease": "3.0.2",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.12",
    "@types/d3-timer": "3.0.2",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.9",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bun-types": "1.4.3",
    "cactus-needle": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-drag": "3.0.0",
    "d3-ease": "3.0.1",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-timer": "3.0.1",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "marked": "18.1.1",
    "playwright-core": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "trustedDependencies": ["electron"]
}

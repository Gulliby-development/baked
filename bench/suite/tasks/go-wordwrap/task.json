{
  "id": "go-wordwrap",
  "language": "go",
  "toolchain": "go",
  "requires": [
    "go"
  ],
  "allowedPaths": [
    "*.go",
    "README.md",
    "go.mod"
  ],
  "checks": [
    {
      "id": "go-vet",
      "executable": "go",
      "args": [
        "vet",
        "./..."
      ],
      "fix": {
        "executable": "go",
        "args": [
          "fmt",
          "./..."
        ]
      }
    },
    {
      "id": "go-test",
      "executable": "go",
      "args": [
        "test",
        "./..."
      ]
    }
  ]
}

{
  "id": "r-testthat-roman",
  "language": "r",
  "toolchain": "testthat",
  "requires": [
    "Rscript"
  ],
  "allowedPaths": [
    "R/**",
    "tests/**",
    "NAMESPACE",
    "README.md"
  ],
  "checks": [
    {
      "id": "testthat",
      "executable": "Rscript",
      "args": [
        "-e",
        "testthat::test_local(reporter = testthat::CheckReporter$new())"
      ]
    },
    {
      "id": "lintr",
      "executable": "Rscript",
      "args": [
        "-e",
        "l <- lintr::lint_package(); print(l); quit(status = as.integer(length(l) > 0))"
      ]
    }
  ]
}

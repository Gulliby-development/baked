{
  "id": "sql-sqlfluff-views",
  "language": "sql",
  "toolchain": "sqlfluff",
  "requires": [
    "sqlfluff",
    "python3"
  ],
  "allowedPaths": [
    "sql/**",
    "tests/**",
    "README.md",
    ".sqlfluff"
  ],
  "checks": [
    {
      "id": "sqlfluff",
      "executable": "sqlfluff",
      "args": [
        "lint",
        "."
      ],
      "fix": {
        "executable": "sqlfluff",
        "args": [
          "fix"
        ]
      }
    }
  ]
}

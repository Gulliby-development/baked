{
  "id": "rust-temperature",
  "language": "rust",
  "toolchain": "cargo",
  "requires": [
    "cargo"
  ],
  "allowedPaths": [
    "src/**",
    "tests/**",
    "README.md",
    "Cargo.toml"
  ],
  "checks": [
    {
      "id": "cargo-test",
      "executable": "cargo",
      "args": [
        "test",
        "--quiet"
      ],
      "fix": {
        "executable": "cargo",
        "args": [
          "fmt"
        ]
      }
    }
  ]
}

{
  "name": "@baked/baked",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "Graph-powered code intelligence — multi-agent coding with codebase-aware AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gulliby-development/baked.git"
  },
  "module": "src/boot.tsx",
  "type": "module",
  "author": "Gulliby",
  "bin": {
    "baked": "./scripts/launcher.mjs",
    "bf": "./scripts/launcher.mjs"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "scripts/launcher.mjs"
  ],
  "scripts": {
    "dev": "bun run src/boot.tsx",
    "build": "bun scripts/build.ts",
    "build:no-compiler": "bun build src/boot.tsx --outdir dist --target bun --external react-devtools-core --entry-naming \"[dir]/index.[ext]\"",
    "build:binary": "bun build src/boot.tsx --compile --external react-devtools-core --outfile bin/baked",
    "bundle": "bash scripts/bundle.sh arm64 darwin",
    "bundle:x64": "bash scripts/bundle.sh x64 darwin",
    "bundle:linux": "bash scripts/bundle.sh x64 linux",
    "bundle:linux-arm64": "bash scripts/bundle.sh arm64 linux",
    "build:binary:windows": "bun scripts/build.ts --compile --target=bun-windows-x64 --outfile=bin/baked-windows-x64.exe",
    "bundle:windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bundle-windows.ps1 -Arch x64",
    "bundle:windows-arm64": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bundle-windows.ps1 -Arch arm64",
    "installer:windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1 -Arch x64",
    "installer:windows-arm64": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1 -Arch arm64",
    "selfextract:windows": "bun build --compile --target=bun-windows-x64 --minify --outfile=bin/baked-installer-x64.exe scripts/installer-cli.mjs",
    "selfextract:windows-arm64": "bun build --compile --target=bun-windows-arm64 --minify --outfile=bin/baked-installer-arm64.exe scripts/installer-cli.mjs",
    "lint": "biome check src/",
    "check:conflicts": "bun scripts/check-conflict-markers.ts",
    "review:adversarial": "bun scripts/adversarial-review.ts",
    "parity:docs": "bun scripts/parity-docs.ts",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "bun test --timeout 30000",
    "bench:suite": "bun bench/suite/run.ts",
    "test:coverage": "bun test --timeout 30000 --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "test:coverage:html": "bun run test:coverage && genhtml coverage/lcov.info --output-directory coverage/html --dark-mode && open coverage/html/index.html",
    "typecheck": "bun check",
    "typecheck:tsc": "tsc --noEmit",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "release:dry": "bash scripts/release.sh patch --dry-run",
    "release:tag": "bash scripts/release.sh tag",
    "postinstall": "bun scripts/postinstall.mjs"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.50.0",
    "@babel/core": "8.0.7",
    "@biomejs/biome": "2.5.15",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-types": "1.4.3",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/mcp": "^2.0.73",
    "@ai-sdk/openai": "^4.0.91",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "0.6.0",
    "@opentui/react": "0.5.17",
    "ai": "^7.0.137",
    "ignore": "^7.0.12",
    "isbinaryfile": "6.0.0",
    "jsonrepair": "^3.15.0",
    "linkedom": "0.18.13",
    "linkify-it": "6.1.0",
    "marked": "18.1.0",
    "react": "19.3.0",
    "shiki": "4.5.0",
    "strip-ansi": "7.2.0",
    "tree-sitter-wasms": "0.1.13",
    "ts-morph": "28.0.0",
    "undici": "^8.11.2",
    "web-tree-sitter": "0.25.10",
    "web-tree-sitter-engine": "npm:web-tree-sitter@0.27.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "0.5.17",
    "@opentui/core-darwin-x64": "0.5.17",
    "@opentui/core-linux-arm64": "0.5.17",
    "@opentui/core-linux-x64": "0.5.17",
    "@opentui/core-win32-arm64": "0.5.17",
    "@opentui/core-win32-x64": "0.5.17"
  }
}

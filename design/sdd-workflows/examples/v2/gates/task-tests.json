{
  "schemaVersion": 1,
  "id": "task-tests",
  "description": "The tests named by the task pass before dependent tasks start.",
  "required": true,
  "scope": "task",
  "timeoutMs": 60000,
  "retries": {
    "max": 0,
    "retryOn": []
  },
  "evidence": {
    "kind": "exit",
    "keepOutputLines": 40,
    "artifactPaths": []
  },
  "type": "command",
  "command": {
    "executable": "bun",
    "args": [
      "test",
      "tests/workflow-status.test.ts"
    ],
    "cwd": ".",
    "envNames": [],
    "writes": []
  }
}

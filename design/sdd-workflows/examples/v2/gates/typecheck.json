{
  "schemaVersion": 1,
  "id": "typecheck",
  "description": "TypeScript compiles without errors.",
  "required": true,
  "scope": "feature",
  "timeoutMs": 120000,
  "retries": {
    "max": 0,
    "retryOn": []
  },
  "evidence": {

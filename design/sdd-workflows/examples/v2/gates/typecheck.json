    "keepOutputLines": 40,
    "artifactPaths": []
  },
  "type": "command",
  "command": {
    "executable": "bun",
    "args": [
      "run",
      "typecheck"
    ],
    "cwd": ".",
    "envNames": [],
    "writes": []
  }
}

{
  "schemaVersion": 1,
  "id": "manual-signoff",
  "description": "A person confirms an observation that no command can check.",
  "required": true,
  "scope": "feature",
  "timeoutMs": 3600000,
  "retries": {
    "max": 0,
    "retryOn": []
  },
  "evidence": {
    "kind": "decision",
    "keepOutputLines": 40,
    "artifactPaths": []
  },
  "type": "human",
  "human": {
    "prompt": "Describe what you observed when you tried the feature.",
    "answer": "evidence",
    "bindsDigest": true
  }
}

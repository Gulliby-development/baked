{
  "schemaVersion": 1,
  "id": "cli-walkthrough",
  "description": "A model runs the status command with --json and checks the visible result. Advisory until its test is promoted.",
  "required": false,
  "scope": "feature",
  "timeoutMs": 600000,
  "retries": {
    "max": 0,
    "retryOn": []
  },
  "evidence": {
    "kind": "recording",
    "keepOutputLines": 40,
    "artifactPaths": []
  },
  "type": "ai-acceptance",
  "acceptance": {
    "scenario": {
      "title": "Status of a run as JSON",
      "steps": [
        "Start a run in a temporary workspace.",
        "Run the status command for that run with --json."
      ],
      "expectations": [
        "The output is one JSON object.",
        "The object contains runId, status and revision."
      ]
    },
    "start": {
      "executable": "bun",
      "args": [
        "run",
        "src/boot.tsx",
        "workflow",
        "list"
      ],
      "cwd": ".",
      "envNames": [],
      "readyWhen": {
        "logIncludes": "runs"
      }
    },
    "driver": "terminal",
    "capabilities": {
      "spawnApp": true,
      "listenPorts": [],
      "outboundHosts": [],
      "writePaths": [
        "test_tmp"
      ]
    },
    "promote": {
      "commandGateId": "acceptance-status-json",
      "testPath": "tests/acceptance/status-json.test.ts",
      "framework": "cli-script",
      "stableRuns": 3
    }
  }
}
